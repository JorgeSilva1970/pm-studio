# Copie para ".env" (não é enviado para o GitHub) / Copy to ".env" (never committed)
# Chave da API da Anthropic para o agente IA (opcional)
ANTHROPIC_API_KEY=sk-ant-...
# Modelo (opcional): claude-sonnet-5-5 | claude-opus-5-5 | claude-haiku-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5
# Base de dados (opcional). Sem esta variável a app usa SQLite local em data/pm_studio.db
# DATABASE_URL=postgresql://utilizador:password@host:5432/pm_studio
